<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="MediatR" Version="11.1.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <!-- MongoDB.Driver 2.2x pulls Snappier 1.0.0 (infinite loop on malformed input, GHSA-pggp-6c3x-2xmx); pin the fix for every service -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <!-- MongoDB.Driver 2.30 pulls SharpCompress 0.30.1 (path traversal on extraction, GHSA-6c8g-7p36-r338); 0.48.1 is the version MongoDB.Driver 3.13 ships against -->
    <PackageReference Include="SharpCompress" Version="0.48.1" />
   
  </ItemGroup>

</Project>
